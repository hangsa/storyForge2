# Vite env vars are exposed to the browser as `import.meta.env.VITE_*`
# (see https://vitejs.dev/guide/env-and-mode)

# Creative Canvas v2 flag — informational only.
# The authoritative flag is backend ENABLE_CANVAS_V2 (see backend/.env.example),
# which controls whether the v2 route group is mounted in backend/main.py.
VITE_CANVAS_V2=false